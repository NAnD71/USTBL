{
  "identifier": "desktop-capability",
  "platforms": ["macOS", "windows", "linux"],
  "windows": ["main", "game_error*", "game_log*"],
  "permissions": [
    "window-state:default",
    "opener:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "ms-windows-store:*"
        }
      ]
    }
  ]
}
